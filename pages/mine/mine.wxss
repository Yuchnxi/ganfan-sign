.mine-page {
  background: var(--color-bg-mine);
}

.profile {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
}

.profile-avatar {
  width: 168rpx;
  height: 168rpx;
  flex: 0 0 168rpx;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.profile-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
}

.profile-subtitle {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.mine-list {
  overflow: hidden;
}

.mine-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 var(--spacing-lg);
  border-bottom: 1px solid var(--color-divider);
}

.mine-item:last-child {
  border-bottom: 0;
}

.mine-item-main {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.mine-item-icon {
  width: 44rpx;
  height: 44rpx;
}

.mine-item-label {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.mine-item-arrow {
  width: 28rpx;
  height: 28rpx;
}
