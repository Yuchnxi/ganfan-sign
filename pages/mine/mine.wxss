.mine-page {
  background: var(--color-bg-mine);
}

.profile {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.profile-avatar {
  width: 168rpx;
  height: 168rpx;
  flex: 0 0 168rpx;
}

.profile-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.profile-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
}

.profile-subtitle {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.profile-setting {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.profile-setting:active {
  transform: scale(0.96);
}

.profile-setting__icon {
  width: 38rpx;
  height: 38rpx;
}

.eaten-card {
  position: relative;
  overflow: hidden;
  padding: var(--spacing-lg);
}

.eaten-card__mascot {
  position: absolute;
  top: 8rpx;
  right: 18rpx;
  width: 116rpx;
  height: 116rpx;
}

.eaten-card__header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  padding-right: 128rpx;
}

.eaten-card__icon {
  width: 40rpx;
  height: 40rpx;
}

.eaten-card__title {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.record-status {
  padding: var(--spacing-xl) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  text-align: center;
}

.record-status--error {
  color: var(--color-danger);
}

.today-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  min-height: 112rpx;
  box-sizing: border-box;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-secondary);
}

.today-date {
  display: flex;
  width: 112rpx;
  flex: 0 0 112rpx;
  flex-direction: column;
  gap: 4rpx;
}

.today-label {
  color: var(--color-accent-red);
  font-size: var(--font-size-md);
  font-weight: 700;
}

.today-day {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.today-meals {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.meal-text {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-block {
  margin-top: var(--spacing-md);
}

.history-title {
  display: block;
  margin-bottom: var(--spacing-sm);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.history-empty {
  padding: var(--spacing-md) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.history-row {
  display: grid;
  align-items: center;
  grid-template-columns: 92rpx minmax(0, 1fr) minmax(0, 1fr);
  column-gap: var(--spacing-sm);
  min-height: 48rpx;
}

.history-date {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.history-meal {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-size-xs);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-records {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 1px solid var(--color-divider);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}

.more-records__arrow {
  width: 24rpx;
  height: 24rpx;
}

.stats-card {
  margin-top: var(--spacing-lg);
  padding: 34rpx var(--spacing-lg) 36rpx;
}

.stats-card__header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.stats-card__title-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.stats-card__icon {
  width: 40rpx;
  height: 40rpx;
}

.stats-card__title {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.stats-card__period {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: var(--spacing-md);
}

.stats-item {
  position: relative;
  display: flex;
  min-height: 152rpx;
  box-sizing: border-box;
  padding: 30rpx var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-secondary);
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.stats-item--count,
.stats-item--food,
.stats-item--category {
  grid-column: span 2;
}

.stats-item--food {
  align-items: center;
  background: var(--color-tag-lunch-bg);
}

.stats-item--category {
  align-items: center;
  background: var(--color-tag-dinner-bg);
}

.stats-item--meal {
  grid-column: span 3;
  display: flex;
  min-height: 144rpx;
  flex-direction: row;
  align-items: center;
  gap: var(--spacing-md);
  text-align: left;
  background: var(--color-tag-both-bg);
}

.stats-item--dinner {
  background: var(--color-tag-huoguo-bg);
}

.stats-item__label {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  font-weight: 600;
}

.stats-item__value {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-count {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
}

.stats-count__number {
  color: var(--color-tag-red);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.stats-count__unit {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.stats-badge-image {
  position: absolute;
  top: -15rpx;
  right: -4rpx;
  width: 42rpx;
  height: 42rpx;
  z-index: 1;
  pointer-events: none;
}

.stats-badge-image--sparkle {
  top: -15rpx;
  right: -2rpx;
  width: 44rpx;
  height: 44rpx;
}

.stats-food-image {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
}

.stats-meal-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
