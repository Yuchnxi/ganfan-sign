<view class="page home-page">
  <view class="home-decor" aria-hidden="true">
    <text class="decor-star star-top-left">✦</text>
    <text class="decor-star star-mid-left">✦</text>
    <text class="decor-star star-mid-right">✦</text>
    <text class="decor-star star-low-right">✦</text>
    <view class="decor-dot dot-left"></view>
    <view class="decor-dot dot-right"></view>
  </view>

  <view class="hero">
    <text class="sparkle sparkle-left">✦</text>
    <text class="title-cn hero-title">干饭签</text>
    <image class="hero-mascot" src="{{imageUrls.heroMascot}}" mode="aspectFit" />
    <text class="hero-subtitle">干饭求一签，今天吃什么交给饭神吧！</text>
  </view>

  <view class="meal-switch" aria-label="选择餐次">
    <button
      class="font-atmosphere meal-option {{selectedMealType === 'lunch' ? 'meal-option-active' : ''}}"
      data-type="lunch"
      bindtap="onSelectMeal"
    >
      午餐
    </button>
    <button
      class="font-atmosphere meal-option {{selectedMealType === 'dinner' ? 'meal-option-active' : ''}}"
      data-type="dinner"
      bindtap="onSelectMeal"
    >
      晚餐
    </button>
  </view>

  <view class="draw-stage">
    <view class="stage-ground stage-ground-back"></view>
    <view class="stage-ground stage-ground-front"></view>
    <view class="decor-cloud cloud-left">
      <view class="cloud-puff cloud-puff-a"></view>
      <view class="cloud-puff cloud-puff-b"></view>
      <view class="cloud-puff cloud-puff-c"></view>
    </view>
    <view class="decor-cloud cloud-right">
      <view class="cloud-puff cloud-puff-a"></view>
      <view class="cloud-puff cloud-puff-b"></view>
      <view class="cloud-puff cloud-puff-c"></view>
    </view>
    <view class="font-atmosphere speech-bubble">
      <text>一签在手，</text>
      <text>干饭不愁！</text>
      <view class="speech-tail"></view>
    </view>
    <image class="draw-scene" src="{{imageUrls.drawScene}}" mode="aspectFill" />
    <image class="stage-friend stage-friend-rice" src="{{imageUrls.riceFriend}}" mode="aspectFit" />
    <image class="stage-friend stage-friend-chick" src="{{imageUrls.chickFriend}}" mode="aspectFill" />
    <image class="stage-friend stage-friend-tomato" src="{{imageUrls.tomatoFriend}}" mode="aspectFill" />
    <view class="draw-actions">
      <button class="btn-primary draw-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onDrawTap">
        {{loading ? '求签中...' : '求一签'}}
      </button>
    </view>
  </view>

  <view class="result-mask" wx:if="{{showResultDialog && drawResult}}">
    <view class="result-dialog">
      <view class="result-ribbon">
        <text>今日{{drawResult.mealTypeLabel}}签</text>
      </view>
      <text class="font-atmosphere result-food-name">{{drawResult.foodName}}</text>
      <view class="result-content">
        <image class="result-food-image" src="{{drawResult.foodImage}}" mode="aspectFit" binderror="onResultImageError" />
        <view class="result-copy">
          <text class="result-tag">签文</text>
          <text class="result-fortune">{{drawResult.fortuneText}}</text>
        </view>
      </view>
      <view class="result-actions">
        <button class="result-button result-button-secondary" disabled="{{loading}}" bindtap="onRedrawTap">
          再来一次
        </button>
        <button class="result-button result-button-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onAcceptTap">
          就吃这个
        </button>
      </view>
      <text class="result-hint">不满意？再抽一次试试！</text>
    </view>
  </view>

</view>
