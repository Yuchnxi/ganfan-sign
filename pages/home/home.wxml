<view class="page home-page">
  <view class="home-decor" aria-hidden="true">
    <text class="decor-star star-top-left">✦</text>
    <text class="decor-star star-mid-left">✦</text>
    <text class="decor-star star-mid-right">✦</text>
    <text class="decor-star star-low-right">✦</text>
    <view class="decor-dot dot-left"></view>
    <view class="decor-dot dot-right"></view>
  </view>

  <view class="hero">
    <text class="sparkle sparkle-left">✦</text>
    <text class="title-cn hero-title">干饭签</text>
    <image class="hero-mascot" src="/assets/images/masco/mascot_rice_mini@2x.png" mode="aspectFit" />
    <text class="hero-subtitle">干饭求一签，今天吃什么交给饭神吧！</text>
  </view>

  <view class="meal-switch" aria-label="选择餐次">
    <button
      class="meal-option {{selectedMealType === 'lunch' ? 'meal-option-active' : ''}}"
      data-type="lunch"
      bindtap="onSelectMeal"
    >
      午餐
    </button>
    <button
      class="meal-option {{selectedMealType === 'dinner' ? 'meal-option-active' : ''}}"
      data-type="dinner"
      bindtap="onSelectMeal"
    >
      晚餐
    </button>
  </view>

  <view class="draw-stage">
    <view class="stage-ground stage-ground-back"></view>
    <view class="stage-ground stage-ground-front"></view>
    <view class="decor-cloud cloud-left">
      <view class="cloud-puff cloud-puff-a"></view>
      <view class="cloud-puff cloud-puff-b"></view>
      <view class="cloud-puff cloud-puff-c"></view>
    </view>
    <view class="decor-cloud cloud-right">
      <view class="cloud-puff cloud-puff-a"></view>
      <view class="cloud-puff cloud-puff-b"></view>
      <view class="cloud-puff cloud-puff-c"></view>
    </view>
    <view class="speech-bubble">
      <text>一签在手，</text>
      <text>干饭不愁！</text>
      <view class="speech-tail"></view>
    </view>
    <image class="draw-scene" src="/assets/images/scene/home_bucket_with_tag@2x.png" mode="aspectFill" />
    <image class="stage-friend stage-friend-rice" src="/assets/images/masco/mascot_rice_waving@2x.png" mode="aspectFit" />
    <image class="stage-friend stage-friend-chick" src="/assets/images/characters/character_chick@2x.png" mode="aspectFill" />
    <image class="stage-friend stage-friend-tomato" src="/assets/images/characters/character_tomato@2x.png" mode="aspectFill" />
    <view class="draw-actions">
      <button class="btn-primary draw-button" bindtap="onDrawTap">求一签</button>
      <text class="draw-count">今日可抽 <text class="draw-count-strong">3</text> 次 ✨</text>
    </view>
  </view>

</view>
