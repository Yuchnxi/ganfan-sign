.home-page {
  --home-title-color: #6F3516;
  --home-copy-color: #7B421F;
  --home-muted-color: #9A6B4B;
  --home-switch-bg: rgba(255, 255, 255, 0.48);
  --home-secondary-bg: #FFE8B8;
  --home-secondary-shadow: #E7BC75;
  --home-bg-start: #FFF3D3;
  --home-bg-mid: #FFF7E5;
  --home-bg-end: #FFF0C8;
  --home-cloud-bg: rgba(255, 255, 255, 0.88);
  --home-ground-back: rgba(255, 220, 139, 0.38);
  --home-ground-front: rgba(255, 249, 226, 0.82);
  position: relative;
  height: 100vh;
  overflow: hidden;
  padding-top: var(--spacing-lg);
  padding-bottom: 0;
  background-color: var(--color-bg-home);
  background-image: linear-gradient(180deg, var(--home-bg-start) 0%, var(--home-bg-mid) 42%, var(--home-bg-end) 100%);
}

.home-decor {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.home-page > .hero,
.home-page > .meal-switch,
.home-page > .draw-stage {
  position: relative;
  z-index: 1;
}

.decor-star {
  position: absolute;
  color: var(--color-primary);
  font-size: 44rpx;
  line-height: 1;
}

.star-top-left {
  left: 48rpx;
  top: 210rpx;
}

.star-mid-left {
  left: 34rpx;
  top: 360rpx;
  font-size: 36rpx;
}

.star-mid-right {
  right: 72rpx;
  top: 500rpx;
  font-size: 38rpx;
}

.star-low-right {
  right: 92rpx;
  top: 610rpx;
  font-size: 34rpx;
}

.decor-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-gold);
  opacity: 0.58;
}

.dot-left {
  left: 134rpx;
  top: 760rpx;
}

.dot-right {
  right: 132rpx;
  top: 738rpx;
}

.decor-cloud {
  position: absolute;
  z-index: 1;
  width: 230rpx;
  height: 112rpx;
  pointer-events: none;
}

.cloud-left {
  left: 0rpx;
  top: 280rpx;
  transform: scale(0.74);
}

.cloud-right {
  right: 0rpx;
  top: 220rpx;
  transform: scale(0.8);
}

.cloud-puff {
  position: absolute;
  bottom: 0;
  border-radius: var(--radius-pill);
  background: var(--home-cloud-bg);
}

.cloud-puff-a {
  left: 0;
  width: 120rpx;
  height: 66rpx;
}

.cloud-puff-b {
  left: 58rpx;
  width: 116rpx;
  height: 100rpx;
}

.cloud-puff-c {
  right: 0;
  width: 128rpx;
  height: 74rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  transform: translateX(28rpx);
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.hero-mascot {
  width: 116rpx;
  height: 116rpx;
  margin-left: var(--spacing-xs);
}

.sparkle {
  position: absolute;
  color: var(--color-primary);
  font-size: 40rpx;
}

.sparkle-left {
  left: 40rpx;
  top: 80rpx;
}

.hero-title {
  color: var(--home-title-color);
  font-size: var(--font-size-xxl);
  line-height: 1.1;
}

.hero-subtitle {
  width: 100%;
  margin-top: var(--spacing-xs);
  color: var(--home-copy-color);
  font-size: var(--font-size-sm);
}

.meal-switch {
  display: flex;
  align-items: center;
  margin: var(--spacing-md) var(--spacing-xl) var(--spacing-sm);
  padding: 6rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--home-switch-bg);
}

.meal-option {
  flex: 1;
  box-sizing: border-box;
  min-height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  font-size: var(--font-size-lg);
  font-weight: 700;
  line-height: 78rpx;
  background: transparent;
}

.meal-option::after {
  border: 0;
}

.meal-option-active {
  color: var(--home-title-color);
  background: var(--color-primary-light);
  box-shadow: 0 4rpx 0 var(--color-primary-dark);
}

.draw-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 650rpx;
  margin-top: 60rpx;
}

.stage-ground {
  position: absolute;
  left: -150rpx;
  z-index: 0;
  width: 1050rpx;
  border-radius: 50% 50% 0 0;
  pointer-events: none;
}

.stage-ground-back {
  top: 386rpx;
  height: 172rpx;
  background: var(--home-ground-back);
}

.stage-ground-front {
  top: 438rpx;
  height: 156rpx;
  background: var(--home-ground-front);
}

.speech-bubble {
  position: absolute;
  left: 10rpx;
  top: 100rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 212rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx 18rpx;
  border-radius: 72rpx 68rpx 72rpx 54rpx;
  color: var(--home-title-color);
  font-size: 26rpx;
  line-height: 1.35;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.speech-bubble text {
  display: block;
  text-align: left;
  white-space: nowrap;
}

.speech-tail {
  position: absolute;
  right: 24rpx;
  bottom: -16rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 22rpx 6rpx 0 32rpx;
  border-color: var(--color-bg-card) transparent transparent transparent;
  transform: rotate(18deg);
}

.draw-scene {
  position: relative;
  z-index: 2;
  width: 460rpx;
  height: 610rpx;
  margin-top: 8rpx;
}

.stage-friend {
  position: absolute;
  transform-origin: center bottom;
  pointer-events: none;
}

.stage-friend-rice {
  left: 86rpx;
  top: 378rpx;
  z-index: 3;
  width: 168rpx;
  height: 168rpx;
}

.stage-friend-chick {
  left: 424rpx;
  top: 354rpx;
  z-index: 1;
  width: 226rpx;
  height: 226rpx;
  border-radius: var(--radius-lg);
}

.stage-friend-tomato {
  right: -8rpx;
  top: 426rpx;
  z-index: 3;
  width: 142rpx;
  height: 142rpx;
  border-radius: var(--radius-lg);
}

.draw-actions {
  position: relative;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  padding-bottom: var(--spacing-lg);
}

.draw-button {
  width: 430rpx;
  margin: 0;
  color: var(--home-title-color);
}

.draw-count {
  margin-top: var(--spacing-md);
  color: var(--home-muted-color);
  font-size: var(--font-size-sm);
}

.draw-count-strong {
  color: var(--color-accent-red);
  font-weight: 700;
}

.result-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 56rpx;
  background: rgba(111, 53, 22, 0.28);
}

.result-dialog {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 54rpx 36rpx 30rpx;
  border: 2rpx solid var(--home-secondary-shadow);
  border-radius: var(--radius-lg);
  background: var(--color-bg-secondary);
  box-shadow: 0 18rpx 42rpx rgba(111, 53, 22, 0.22);
}

.result-ribbon {
  position: absolute;
  top: -30rpx;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 220rpx;
  height: 60rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  color: var(--color-text-on-dark);
  font-size: var(--font-size-sm);
  font-weight: 700;
  background: var(--color-accent-red);
  transform: translateX(-50%);
  box-shadow: 0 6rpx 0 var(--color-accent-red-dark);
}

.result-food-name {
  display: block;
  color: var(--home-title-color);
  font-size: var(--font-size-xl);
  line-height: 1.2;
  text-align: center;
}

.result-content {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-lg);
}

.result-food-image {
  flex-shrink: 0;
  width: 230rpx;
  height: 190rpx;
}

.result-copy {
  flex: 1;
  min-width: 0;
  margin-left: var(--spacing-md);
  padding-left: var(--spacing-md);
  border-left: 2rpx solid var(--color-border);
}

.result-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 44rpx;
  border-radius: var(--radius-pill);
  color: var(--color-text-on-dark);
  font-size: var(--font-size-xs);
  background: var(--color-primary-dark);
}

.result-fortune {
  display: block;
  margin-top: var(--spacing-sm);
  color: var(--home-copy-color);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.result-button {
  flex: 1;
  min-height: 84rpx;
  margin: 0;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  font-weight: 700;
  line-height: 84rpx;
}

.result-button::after {
  border: 0;
}

.result-button-secondary {
  color: var(--home-title-color);
  background: var(--home-secondary-bg);
  box-shadow: 0 4rpx 0 var(--home-secondary-shadow);
}

.result-button-primary {
  color: var(--color-text-on-dark);
  background: var(--color-accent-red);
  box-shadow: 0 4rpx 0 var(--color-accent-red-dark);
}

.result-hint {
  display: block;
  margin-top: var(--spacing-md);
  color: var(--home-muted-color);
  font-size: var(--font-size-xs);
  text-align: center;
}
